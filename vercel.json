{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(style\\.css|script\\.js|manifest\\.json|sw\\.js|favicon\\.ico)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/main.php"
    }
  ]
}
