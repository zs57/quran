{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0"
    },
    "index.php": {
      "runtime": "vercel-php@0.6.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.php?$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
